{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Uvicorn",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "uvicorn",
        "backend.app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: Vite",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Ngrok: Backend",
      "type": "shell",
      "command": "ngrok",
      "args": [
        "http",
        "8000"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: All",
      "dependsOn": [
        "Backend: Uvicorn",
        "Frontend: Vite",
        "Ngrok: Backend"
      ],
      "dependsOrder": "parallel"
    }
  ]
}
